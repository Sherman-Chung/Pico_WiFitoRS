<mxfile host="app.diagrams.net" modified="2026-03-04T00:00:00.000Z" agent="Codex" version="20.8.20" type="device">
  <diagram id="modbus-flow" name="Modbus Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="m_start" value="以事件方式輪詢並處理&#xa;每一筆 Modbus 請求" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_sock" value="Modbus TCP 服務&#xa;是否已啟動並可接收連線？" style="fontSize=14;fontFamily=Times New Roman;rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="0" y="140" width="240" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="m_return" value="本輪暫不處理&#xa;返回主迴圈等待下次輪詢" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="183" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_accept" value="若目前沒有活動連線&#xa;則接入新的客戶端連線" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="345" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_read" value="以非阻塞方式接收資料&#xa;並累積到連線緩衝區" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="465" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_cfg" value="當緩衝區有完整封包&#xa;解析並讀取 REG1/REG2/REG3" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="585" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_indirect" value="Unit ID == tcp_slave_id ?" style="fontSize=14;fontFamily=Times New Roman;rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="0" y="825" width="240" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="m_local" value="REG3 = disabled 且&#xa;Unit ID != tcp_slave_id ?" style="fontSize=14;fontFamily=Times New Roman;rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="0" y="705" width="240" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="m_regs" value="本地 Hold Register&#xa;FC03/04/06/16" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="868" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_map" value="讀 cfg 通道參數並依 REG3&#xa;固定路由 ch0 或 ch1" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1030" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_ch" value="目標通道有啟用?" style="fontSize=14;fontFamily=Times New Roman;rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="0" y="1150" width="240" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="m_exc1" value="REG3=disabled 且非本地 Unit ID&#xa;回傳錯誤碼 0x03" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="1193" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_lock" value="嘗試取得 RS485 匯流排使用權&#xa;避免同時傳輸衝突" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1355" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_lockok" value="是否成功取得&#xa;RS485 使用權？" style="fontSize=14;fontFamily=Times New Roman;rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="0" y="1475" width="240" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="m_exc2" value="匯流排忙碌或鎖定失敗&#xa;回傳錯誤碼 0x06" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="1518" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_send" value="依通道模式 RTU/ASCII&#xa;組包送往對應設備" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1680" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_read2" value="等待設備回覆資料&#xa;讀取後進行內容解析" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="1900" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_valid" value="回覆內容是否完整、合法&#xa;且與請求相符？" style="fontSize=14;fontFamily=Times New Roman;rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="660" y="1695" width="240" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="m_exc3" value="通道不可用或回覆異常&#xa;回傳錯誤碼 0x0B" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="1738" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_resp" value="將有效資料封裝成&#xa;Modbus TCP 回應並回傳" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="1575" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="m_release" value="釋放 RS485 使用權並結束本次處理&#xa;TCP 連線可持續保留" style="fontSize=14;fontFamily=Times New Roman;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="1455" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="me1" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_start" target="m_sock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me2" value="否" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_sock" target="m_return">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me3" value="是" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_sock" target="m_accept">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me4" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_accept" target="m_read">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me5" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_read" target="m_cfg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me6" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_cfg" target="m_local">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me7" value="是" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_indirect" target="m_regs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me8" value="否" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_indirect" target="m_map">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me9" value="是" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_local" target="m_exc1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me10" value="否" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_local" target="m_indirect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me11" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_map" target="m_ch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me12" value="否" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_ch" target="m_exc3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me13" value="是" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_ch" target="m_lock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me14" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_lock" target="m_lockok">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me15" value="否" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_lockok" target="m_exc2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="me16" value="是" style="fontSize=14;fontFamily=Times New Roman;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="m_lockok" target="m_send">
          <mxGeometry relative="1" as="geometry"/>
